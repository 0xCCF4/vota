{
  description = "Vota: personal Ballots with an admin API and a voting UI";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    flake-parts = {
      url = "github:hercules-ci/flake-parts";
      inputs.nixpkgs-lib.follows = "nixpkgs";
    };
  };

  outputs =
    inputs@{ flake-parts, self, ... }:
    flake-parts.lib.mkFlake { inherit inputs; } {
      systems = [
        "x86_64-linux"
        "aarch64-linux"
        "aarch64-darwin"
      ];

      # System-independent outputs.
      flake = {
        # `services.vota`; see docs/guides/deployment.md#nixos.
        nixosModules = {
          default = self.nixosModules.vota;
          vota = import ./nix/module.nix { inherit self; };
        };
      };

      perSystem =
        { config, pkgs, ... }:
        let
          inherit (pkgs) lib;

          # Package source: the whole repo minus things not needed to build.
          # Exclude-list (not include-list), so new directories such as
          # templates/, static/ or new migrations are picked up automatically.
          # (In a flake, only git-tracked files are visible in the first place.)
          topLevelResultLinks = lib.pipe (builtins.readDir ./.) [
            builtins.attrNames
            (lib.filter (name: name == "result" || lib.hasPrefix "result-" name))
            (map (name: ./. + "/${name}"))
          ];
          excluded = lib.fileset.unions (
            [
              (lib.fileset.maybeMissing ./target)
              (lib.fileset.maybeMissing ./.scratch)
              (lib.fileset.maybeMissing ./docs)
              (lib.fileset.maybeMissing ./.idea)
              (lib.fileset.maybeMissing ./.direnv)
              (lib.fileset.maybeMissing ./.gitignore)
              (lib.fileset.maybeMissing ./flake.nix)
              (lib.fileset.maybeMissing ./flake.lock)
              (lib.fileset.maybeMissing ./nix)
              (lib.fileset.fileFilter (file: file.hasExt "md") ./.)
            ]
            ++ topLevelResultLinks
          );
          src = lib.fileset.toSource {
            root = ./.;
            fileset = lib.fileset.difference ./. excluded;
          };
          votaArgs = {
            pname = "vota";
            version = (builtins.fromTOML (builtins.readFile ./Cargo.toml)).package.version;
            inherit src;
            # All dependencies are pinned by Cargo.lock; no network during the build.
            # The test suite runs in checkPhase (doCheck defaults to true).
            cargoLock.lockFile = ./Cargo.lock;
            # Shell completions (bash, zsh, fish, nushell: the shells with a
            # standard place in a Nix profile) and a man page per command,
            # generated by the binary itself (`vota completions <shell>`,
            # `vota man <dir>`). Skipped when cross-compiling: the build
            # can't run the binary.
            nativeBuildInputs = [ pkgs.installShellFiles ];
            postInstall = lib.optionalString (pkgs.stdenv.buildPlatform.canExecute pkgs.stdenv.hostPlatform) ''
              installShellCompletion --cmd vota \
                --bash <($out/bin/vota completions bash) \
                --zsh <($out/bin/vota completions zsh) \
                --fish <($out/bin/vota completions fish) \
                --nushell <($out/bin/vota completions nushell)
              $out/bin/vota man man-pages
              installManPage man-pages/*.1
            '';
            meta = {
              description = "Personal Ballots with an admin API and a voting UI";
              mainProgram = "vota";
              license = lib.licenses.gpl3Plus;
              homepage = "https://github.com/0xCCF4/vota";
            };
          };
        in
        {
          packages = {
            default = config.packages.vota;
            vota = pkgs.rustPlatform.buildRustPackage votaArgs;
            # Only the admin API client (`vota ballot …`), `completions` and
            # `man` (with the pages and completions of these commands),
            # for hosts that manage Ballots on a server elsewhere: cargo
            # feature `client` without `server`, so no database or web server.
            # Its checkPhase runs the tests of that build.
            vota-client = pkgs.rustPlatform.buildRustPackage (
              votaArgs
              // {
                pname = "vota-client";
                buildNoDefaultFeatures = true;
                buildFeatures = [ "client" ];
                meta = votaArgs.meta // {
                  description = "The admin API client of Vota (vota ballot), without the server";
                };
              }
            );
          };

          devShells.default = pkgs.mkShell {
            inputsFrom = [ config.packages.vota ];
            packages = with pkgs; [
              cargo
              rustc
              clippy
              rustfmt
              rust-analyzer
              sqlx-cli
              sqlite
            ];
          };

          # The NixOS VM test of the module (Linux hosts only).
          checks = lib.optionalAttrs pkgs.stdenv.hostPlatform.isLinux {
            nixos-vm = import ./nix/vm-test.nix { inherit self pkgs; };
          };

          formatter = pkgs.nixfmt;
        };
    };
}
